# Explicit source selection: database is the default; fixtures are an
# intentionally separate, display-only development mode with no analytics.
DATA_SOURCE=database

# Public map style URL; safe to use in browser code. OpenFreeMap's Positron
# style is the no-key pilot default. Replace it with any MapLibre-compatible style.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Server-side Supabase configuration. The cookie-aware anon client still uses
# the publishable/anon key; Phase 3 spatial APIs use a separate stateless client.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-project-publishable-or-anon-key

# Elevated credential used only by src/lib/supabase/admin.ts (server-only).
# Prefer Supabase's new secret key mechanism; the legacy service-role key is a
# compatibility fallback for projects that have not moved to secret keys.
# Never use NEXT_PUBLIC_*, import this module in a client component, or log either key.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Phase 7 report maps (optional). With a server-only Mapbox token, generated
# reports embed a Mapbox Static Images map (attribution is always preserved).
# Never use NEXT_PUBLIC_* for this token, and never return it to a client.
MAPBOX_ACCESS_TOKEN=
REPORT_MAP_STYLE=mapbox/light-v11

# Deterministic report map fixture for tests and CI: no network, no token and no
# map credits. Never enable this in a production deployment.
# REPORT_MAP_PROVIDER=fake
