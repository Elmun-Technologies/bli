# Public map style URL; safe to use in browser code. OpenFreeMap's Positron
# style is the no-key pilot default. Replace it with any MapLibre-compatible style.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Server-only Supabase connection for the App Router server client.
# Use your project's URL and publishable/anon key. Do not prefix keys with
# NEXT_PUBLIC_ unless they are intentionally browser-safe.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-project-publishable-or-anon-key

# A service-role/secret key is intentionally not used by this phase.
# Never expose one through NEXT_PUBLIC_* or include it in client-side code.
