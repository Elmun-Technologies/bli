{
  "name": "location-intelligence-platform",
  "version": "0.1.0",
  "private": true,
  "description": "A modular Web GIS and location intelligence workspace, starting with a Tashkent pilot.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/geo/*.test.ts src/lib/domain/*.test.ts src/lib/map/*.test.ts src/lib/spatial/*.test.ts src/components/app/*.test.ts",
    "smoke:fixtures": "tsx scripts/smoke-fixtures-mode.ts",
    "verify:database": "bash scripts/verify-database.sh",
    "verify": "npm run verify:database && npm test && npm run lint && npm run typecheck && npm run build && npm run smoke:fixtures"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.12.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.15.30",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.6",
    "supabase": "2.119.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.0"
  }
}
